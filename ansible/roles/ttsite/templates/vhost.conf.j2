# {{ ansible_managed }} -- {{ ttsite_domain }}
# Published via ten64's reverse proxy (http) / SNI passthrough (https); TLS
# terminates here with a webroot-issued Let's Encrypt cert (see roles/ttsite).
{% macro app_locations() %}
    root {{ static_dir }};
    access_log /var/log/nginx/{{ ttsite_domain }}-access.log;
    error_log /var/log/nginx/{{ ttsite_domain }}-error.log;
    client_max_body_size 1m;

    location /static/ {
        alias {{ static_dir }}/;
    }

    include includes/{{ conference_name }}-live-hls.conf;
    include includes/{{ ttsite_domain }}-*.conf;

    location /ws/pistat/ {
        proxy_pass http://localhost:8085/ws/pistat/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /api/ {
        include proxy_params;
        proxy_pass http://unix:/run/gunicorn.sock;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/gunicorn.sock;
    }
{% endmacro %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ ttsite_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
{% if ttsite_cert_exists | bool %}

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ ttsite_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ ttsite_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ ttsite_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    add_header Strict-Transport-Security "max-age=15552000";
{{ app_locations() }}}
{% else %}
{{ app_locations() }}}
{% endif %}

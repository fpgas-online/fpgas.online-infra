# IPv6 for the netbooted Pi's network interface, from the host name: see
# /usr/local/sbin/fpgas-ipv6 for the formula and why it is static.
[Unit]
Description=IPv6 address and default route for the board's interface, from the host name
ConditionPathExists=/etc/fpgas-online/ipv6-base
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fpgas-ipv6

[Install]
WantedBy=multi-user.target

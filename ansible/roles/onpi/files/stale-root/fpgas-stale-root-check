#!/bin/sh
# fpgas-stale-root-check -- reboot this Pi once its NFS root has changed
# underneath it (fpgas.online-infra, roles/onpi/tasks/stale_root.yml).
#
# The Pis boot with overlayroot=tmpfs over a read-only NFSv3 lower layer
# (/media/root-ro). Rebuilding that root on the server replaces inodes the
# running overlay still holds, and from then on every replaced file answers
# ESTALE: dpkg-query, key-based ssh (authorized_keys), anything that opens a
# replaced file. The streams keep running, so the board looks healthy from
# outside. Only a reboot fixes it.
#
# This script is run by fpgas-stale-root.timer, but NOT from the NFS root:
# fpgas-stale-root-arm copies it, a static busybox and its config into /run
# at boot. A root that went stale under us cannot stop us from running, or
# from rebooting.
#
# Triggers, in order of preference:
#   1. generation: the server bumped /etc/fpgas-online/nfsroot-generation
#      (roles/nfsroot-generation writes it as the LAST step of a run that
#      changed the root) since this board booted.
#   2. estale: a probe file has gone stale (ESTALE, or vanished) on CONFIRM
#      consecutive checks, and the lower root has been quiet for QUIET s.
#      This catches root changes made outside site.yml.
# Holds (checked first, any one stops a reboot):
#   - the server's update lock (a site.yml run is part-way through
#     changing the root; rebooting now would boot a half-built root),
#   - the fleet-wide inhibit file in the root,
#   - the per-board inhibit file in /run (`touch` it to pin a board).
# Each board waits BASE_DELAY + slot * SPACING (+ jitter) after the
# generation's timestamp before rebooting. The slot comes from the board's
# switch placement, so no two boards on the site pick the same moment.
#
#   fpgas-stale-root-check            run one check (what the timer does)
#   fpgas-stale-root-check slot NAME  print the stagger slot for hostname NAME

set -u

STATE=${FPGAS_STALE_ROOT_STATE:-/run/fpgas-stale-root}
# shellcheck source=/dev/null
. "$STATE/config"
PATH=$STATE/bin
LC_ALL=C
export PATH LC_ALL

# --- stagger slot --------------------------------------------------------

# Strip leading zeros: shell arithmetic reads "08" as a bad octal number.
decimal() {
	d=$(echo "$1" | sed 's/^0*//')
	echo "${d:-0}"
}

# pi-sw<S>-p<P> -> one slot per switch port, so boards on the same site never
# share one. Other names: a trailing number (ps1's piNN), else a hash.
slot_for() {
	name=$1
	case $name in
	pi-sw*-p*)
		s=${name#pi-sw}
		s=${s%%-p*}
		p=${name##*-p}
		case "$s$p" in
		'' | *[!0-9]*) ;;
		*)
			s=$(decimal "$s")
			p=$(decimal "$p")
			echo $(((((s - 1) * PORTS_PER_SWITCH) + p - 1) % SLOTS))
			return
			;;
		esac
		;;
	esac
	n=$(echo "$name" | sed -n 's/^.*[^0-9]\([0-9][0-9]*\)$/\1/p')
	if [ -n "$n" ]; then
		echo $(($(decimal "$n") % SLOTS))
		return
	fi
	h=$(echo "$name" | md5sum | cut -c1-6)
	echo $((0x$h % SLOTS))
}

if [ "${1:-}" = slot ]; then
	slot_for "$2"
	exit 0
fi

# --- helpers ---------------------------------------------------------------

now=$(date +%s)

log() {
	echo "$*"
}

# The kernel log goes to the server over netconsole (cmdline.txt), which is
# the only record of why a board rebooted that outlives the reboot.
kmsg() {
	log "$*"
	echo "fpgas-stale-root: $*" >"$KMSG" || true
}

# Log a hold reason once, not every minute.
hold() {
	if [ "$(cat "$STATE/hold" 2>&1)" != "$*" ]; then
		log "holding: $*"
		echo "$*" >"$STATE/hold"
	fi
	rm -f "$STATE/deadline" "$STATE/reason"
	exit 0
}

# First field of a lower-root file ("<epoch> ..."), "none" if absent,
# "estale" if the lower itself answers ESTALE.
read_lower() {
	f=$LOWER$1
	if [ ! -e "$f" ]; then
		echo none
		return
	fi
	if out=$(head -n 1 "$f" 2>&1); then
		echo "$out"
	else
		case $out in
		*"Stale file handle"*) echo estale ;;
		*) echo "unreadable: $out" ;;
		esac
	fi
}

is_number() {
	case ${1:-x} in
	*[!0-9]*) return 1 ;;
	esac
}

# A server timestamp we can do arithmetic with: numeric, not in our future
# (beyond 5 min of clock skew) and not older than LOCK_MAX_AGE. Pis without a
# synced clock fail this and fall back to their own "now".
plausible_epoch() {
	is_number "$1" && [ "$1" -le $((now + 300)) ] && [ $((now - $1)) -lt "$LOCK_MAX_AGE" ]
}

# --- holds -------------------------------------------------------------------

if [ -e "$BOARD_INHIBIT" ]; then
	hold "board inhibit $BOARD_INHIBIT exists"
fi
if [ -e "$LOWER$FLEET_INHIBIT" ]; then
	hold "fleet inhibit $FLEET_INHIBIT exists in the NFS root"
fi

lock=$(read_lower "$LOCK_FILE")
if [ "$lock" != none ]; then
	lock_epoch=${lock%% *}
	# An unreadable or unparseable lock, or a clock we cannot trust, still
	# holds: rebooting into a half-built root is worse than waiting.
	if ! is_number "$lock_epoch" || [ "$lock_epoch" -gt $((now + 300)) ] ||
		[ $((now - lock_epoch)) -lt "$LOCK_MAX_AGE" ]; then
		rm -f "$STATE/estale-count"
		hold "NFS root update in progress ($LOCK_FILE: $lock)"
	fi
	log "ignoring update lock older than ${LOCK_MAX_AGE}s: $lock"
fi

# --- triggers ----------------------------------------------------------------

reason=
ref=$now

boot_gen=$(cat "$STATE/boot-generation")
gen=$(read_lower "$GEN_FILE")
if [ "$gen" != "$boot_gen" ]; then
	reason="generation changed: booted with '$boot_gen', root now '$gen'"
	gen_epoch=${gen%% *}
	if plausible_epoch "$gen_epoch"; then
		ref=$gen_epoch
	fi
fi

# stat through the overlay: a replaced file answers ESTALE (or, sometimes,
# ENOENT), while its directory and every untouched file stay fine.
stale=
for p in $PROBES; do
	if out=$(stat -c %i "$ROOT$p" 2>&1); then
		continue
	fi
	case $out in
	*"Stale file handle"*)
		stale="$stale $p"
		;;
	*"No such file"*)
		if grep -qxF -e "$p" "$STATE/probes-present"; then
			stale="$stale $p(gone)"
		fi
		;;
	*) log "probe $p: $out" ;;
	esac
done

count=0
if [ -n "$stale" ]; then
	if [ -e "$STATE/estale-count" ]; then
		count=$(cat "$STATE/estale-count")
	fi
	count=$((count + 1))
fi
echo "$count" >"$STATE/estale-count"

if [ -z "$reason" ] && [ "$count" -ge "$CONFIRM" ]; then
	# No generation bump, so nothing says the change is finished. A root
	# changed outside site.yml is only trusted once its busiest directories
	# have been still for QUIET seconds.
	newest=0
	for d in $QUIET_DIRS; do
		m=$(stat -c %Y "$LOWER$d" 2>&1) || continue
		is_number "$m" && [ "$m" -gt "$newest" ] && newest=$m
	done
	if [ "$newest" -gt $((now + 300)) ] || [ $((now - newest)) -lt "$QUIET" ]; then
		hold "stale files:$stale, but the NFS root changed $((now - newest))s ago (< ${QUIET}s)"
	fi
	reason="stale files for $count checks:$stale"
fi

if [ -z "$reason" ]; then
	if [ -e "$STATE/deadline" ]; then
		log "root is consistent again, cancelling the scheduled reboot"
	fi
	rm -f "$STATE/deadline" "$STATE/reason" "$STATE/hold"
	exit 0
fi
rm -f "$STATE/hold"

# --- schedule ------------------------------------------------------------------

if [ ! -e "$STATE/deadline" ]; then
	slot=$(slot_for "$(cat "$HOSTNAME_FILE")")
	jit=0
	if [ "$JITTER" -gt 0 ]; then
		jit=$((0x$(head -c 8 /dev/urandom | md5sum | cut -c1-6) % JITTER))
	fi
	deadline=$((ref + BASE_DELAY + slot * SPACING + jit))
	if [ "$deadline" -lt "$now" ]; then
		deadline=$now
	fi
	echo "$deadline" >"$STATE/deadline"
	echo "$reason" >"$STATE/reason"
	kmsg "$reason; slot $slot, rebooting in $((deadline - now))s"
fi

deadline=$(cat "$STATE/deadline")
if [ "$now" -lt "$deadline" ]; then
	exit 0
fi

users=$(who | wc -l)
if [ "$users" -gt 0 ] && [ "$now" -lt $((deadline + USER_GRACE)) ]; then
	if [ ! -e "$STATE/user-wait" ]; then
		log "deferring reboot up to ${USER_GRACE}s: $users login session(s)"
		touch "$STATE/user-wait"
	fi
	exit 0
fi

# --- reboot --------------------------------------------------------------------

reason=$(cat "$STATE/reason")
if [ "$DRY_RUN" = 1 ]; then
	if [ ! -e "$STATE/dry-run-fired" ]; then
		kmsg "DRY_RUN: would reboot now ($reason)"
		touch "$STATE/dry-run-fired"
	fi
	exit 0
fi

kmsg "rebooting: $reason"
# A clean reboot needs systemctl AND the systemd-shutdown binary PID 1 execs
# at the very end; if that exec fails PID 1 freezes instead of rebooting. If
# either is stale, skip straight to a forced reboot: the root is read-only
# and the overlay is tmpfs, so there is nothing to flush.
if stat "$SYSTEMCTL" "$SYSTEMD_SHUTDOWN" >/dev/null && "$SYSTEMCTL" reboot; then
	exit 0
fi
kmsg "clean reboot unavailable, forcing"
sync
reboot -f

# {{ ansible_managed }} (roles/onpi, tasks/stale_root.yml)
# Sourced by fpgas-stale-root-arm, which copies it to /run at boot; edits
# on a running board take effect only after a reboot.
LOWER=/media/root-ro
ROOT=
GEN_FILE={{ nfsroot_generation_file }}
LOCK_FILE={{ nfsroot_update_lock }}
FLEET_INHIBIT={{ nfsroot_fleet_inhibit }}
BOARD_INHIBIT={{ stale_root_board_inhibit }}
PROBES="{{ stale_root_probes | join(' ') }}"
QUIET_DIRS="/var/lib/dpkg /var/lib/dpkg/updates /boot /boot/firmware /etc /usr/bin /usr/lib"
HOSTNAME_FILE=/proc/sys/kernel/hostname
KMSG=/dev/kmsg
SYSTEMCTL=/usr/bin/systemctl
SYSTEMD_SHUTDOWN=/usr/lib/systemd/systemd-shutdown
PORTS_PER_SWITCH={{ stale_root_ports_per_switch }}
SLOTS={{ stale_root_slots }}
SPACING={{ stale_root_spacing }}
JITTER={{ stale_root_jitter }}
BASE_DELAY={{ stale_root_base_delay }}
CONFIRM={{ stale_root_confirm }}
QUIET={{ stale_root_quiet }}
LOCK_MAX_AGE={{ stale_root_lock_max_age }}
USER_GRACE={{ stale_root_user_grace }}
DRY_RUN={{ stale_root_dry_run | bool | ternary(1, 0) }}

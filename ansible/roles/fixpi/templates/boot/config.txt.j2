# =====================================================================
# fpgas.online managed settings
# ---------------------------------------------------------------------
# This file (fixpi/templates/boot/config.txt.j2) is the SINGLE OWNER of
# the netboot config.txt. Everything above this line is the stock RpiOS
# config.txt, tracked verbatim in fixpi/files/boot/config.txt.stock and
# guarded by the "stock config.txt drift" assertion in netboot.yml — if
# the pinned RpiOS image ships a changed config.txt the build FAILS until
# the snapshot and this file are reconciled. Everything below is ours.
# Do NOT modify config.txt from any other task; add settings here.
# See docs/superpowers/runbooks/2026-09-02-config-txt-single-owner.md
# =====================================================================

# --- Disable the onboard radios; enable UART + 2nd-stage boot logging ---
# config.txt is served read-only from the TFTP root, so these re-apply on
# every boot: a root user can bring a radio up for one session, but it never
# survives a reboot, and the default is disabled. On Pi 5 (BCM2712) the
# firmware auto-remaps disable-wifi -> disable-wifi-pi5 and disable-bt ->
# disable-bt-pi5 via overlay_map.dtb, so one line each covers Pi 4 and Pi 5.
#   disable-wifi: Pi 4 disables &mmc/&mmcnr, Pi 5 disables &sdio2 (WLAN never enumerates)
#   disable-bt:   Pi 4 disables &bt, Pi 5 disables &bluetooth
dtoverlay=disable-wifi
dtoverlay=disable-bt
enable_uart=1
uart_2ndstage=1

# --- Write-protect the bootloader EEPROM ---
# The SPI-flash EEPROM is the one piece of per-board state a netbooted Pi does
# NOT revert on reboot, so it is the only place a root user could leave a
# persistent change. eeprom_write_protect=1 sets the flash Write Status
# Register to block rpi-eeprom-update/config. Pi 5: /WP is pulled low by
# default so this is hardware-enforced immediately (undo needs bridging
# TP14<->TP1); Pi 4: /WP (TP5) is not asserted by default, so ground TP5 to make
# it hardware-enforced. To update an EEPROM later, set =0, reboot, flash, restore.
# See docs/superpowers/runbooks/2026-08-31-eeprom-write-protect.md
eeprom_write_protect=1

# --- USB gadget console: dwc2 peripheral mode on OTG-capable boards ---
[pi4]
dtoverlay=dwc2,dr_mode=peripheral
[pi5]
dtoverlay=dwc2,dr_mode=peripheral

# --- Pi 5 40-pin header UART on its own dedicated debug console ---
# disable-bt frees the header UART on Pi 0-4 as a side effect, but disable-bt-pi5
# never touches uart0, and bcm2712-rpi-5-b.dtb ships the RP1 header UART
# (alias serial0) disabled -- so /dev/ttyAMA0 never appears without uart0-pi5.
# cmdline=cmdline-pi5.txt is not cosmetic: enabling uart0 makes the firmware
# resolve console=serial0 to ttyAMA0, putting the kernel console (and a getty)
# on the FPGA's UART where SysRq reads garbage as reboot/crash. Pinning the Pi 5s
# to their dedicated debug UART keeps the console off the FPGA and ttyAMA0 free.
# See fpgas.online-test-designs docs/hardware/acorn-pinmap.md
[pi5]
dtoverlay=uart0-pi5
cmdline=cmdline-pi5.txt

[all]

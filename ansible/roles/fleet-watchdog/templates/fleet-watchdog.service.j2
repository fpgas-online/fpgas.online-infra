# {{ ansible_managed }}
[Unit]
Description=fpgas.online fleet watchdog
Documentation=https://github.com/fpgas-online/fpgas.online-poe
After=network-online.target
Wants=network-online.target
# The service exits non-zero when it cannot do its job: a sweep that raised,
# or {{ fleet_watchdog_unhealthy_exit_after }} consecutive sweeps that found
# nothing or tripped the circuit breaker. Restart=always then brings it back.
# These two lines are what stops that being an infinite quiet retry: if it
# keeps exiting, systemd gives up and puts the unit in `failed`, which is the
# only state `systemctl is-failed` -- or anything else outside the journal --
# can actually see. A structural fault (bad config) burns the budget in about
# two minutes; a persistent unhealthy fleet takes about an hour.
StartLimitIntervalSec={{ fleet_watchdog_start_limit_interval }}
StartLimitBurst={{ fleet_watchdog_start_limit_burst }}

[Service]
Type=exec
User={{ fleet_watchdog_user }}
Group={{ fleet_watchdog_user }}
# ProtectHome hides /home, so ssh needs to be told where HOME is. It never
# writes there: the identity and known_hosts are both passed on the command
# line and StrictHostKeyChecking=yes adds no host keys.
Environment=HOME={{ fleet_watchdog_home }}
EnvironmentFile={{ fleet_watchdog_env_file }}
ExecStart={{ fleet_watchdog_venv }}/bin/fpgas-fleet-watchdog --config {{ fleet_watchdog_config_file }}
Restart=always
RestartSec=30
# The handler below restarts this unit on any config/env/unit change, which
# sends SIGTERM. The service catches it and finishes the sweep in progress
# rather than dying mid-cycle, but one cycle can take up to the 30s off dwell
# plus a 60s confirm-it-came-back-on poll: give it room, so systemd does not
# SIGKILL before that completes.
TimeoutStopSec=150
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ fleet_watchdog_home }}

[Install]
WantedBy=multi-user.target

# Ansible managed

application pib {
    allow publish {{ eth_local_address }}/{{ eth_local_netmask }};
    deny publish all;

    allow play all;

    live on;

    # No `wait_video on;` (it was inherited from the DebConf video setup,
    # whose streams carry audio). The camera feeds are video-only, where its
    # one effect is that nginx-rtmp sends every subscriber a ZERO-LENGTH
    # audio message (dummy_audio in ngx_rtmp_live_module.c) right after the
    # video codec header. That message is legal RTMP, but gortmplib - and so
    # mediamtx's RTMP pull in roles/cam/webrtc - rejects it as "not enough
    # bytes" and drops the connection. Verified 2026-09-20 against stock
    # mediamtx v1.20.1 and v1.21.0: on = every pull dies, absent = 75 s clean.
    # Start every subscriber on a keyframe.
    wait_key on;

    hls on;
    hls_path {{ streaming.data_root }}/hls/source;
    hls_fragment_naming system;

    # Latency: nginx-rtmp closes a fragment at the first keyframe after
    # hls_fragment, and video.js starts 3 x TARGETDURATION behind the newest
    # listed fragment. The Pis (fpgas-online-cam) send a keyframe every second;
    # 900ms rather than 1s so ms-rounding jitter in the RTMP timestamps
    # (fragments came out 5.000/5.999 s with the 5 s default) never skips a
    # keyframe and doubles the fragment. Measured 2026-08-30: 10 s fragments
    # gave ~40 s glass-to-glass; 1 s fragments are expected to give ~5 s
    # (fpgas.online-cam tests/ measure it). The window
    # (playlist length / fragment) is 8 fragments; hls_cleanup (default on)
    # removes older files.
    #
    # The playlist length does NOT affect latency (that is 3 x fragment of
    # player hold-back + the fragment in progress); it is the DVR window:
    # video.js with liveui exposes it as a seekable "rewind" range. 10 min
    # of 1 s fragments ~= 666 playlist entries; hls_cleanup (default on)
    # keeps ~2x the window, so up to ~300 MB per stream at ~2 Mbit/s
    # (~6 GB for 20 Pis) - which is why the hls directory is a plain disk
    # directory, not a tmpfs (tasks/back.yml).
    hls_fragment 900ms;
    hls_playlist_length 600s;

}

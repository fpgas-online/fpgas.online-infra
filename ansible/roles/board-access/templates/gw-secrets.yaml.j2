# {{ ansible_managed }} -- fpgas-online-gw secrets (root:{{ gw_user }}, 0640).
# Real tokens are vaulted in inventory (vault_gw_tokens -> gw_tokens); the
# role default is a fake CI-only value.  PoE communities reuse the per-switch
# vault_switch<N>_snmp_rw_community vars via the `switches` list.
tokens:
{% for t in gw_tokens %}
  - {name: {{ t.name | to_json }}, token: {{ t.token | to_json }}}
{% endfor %}
{% set gw_comms = switches | default([]) | selectattr('snmp_rw_community', 'defined') | list %}
{% if gw_comms %}
poe_communities:
{% for sw in gw_comms %}
  {{ sw.index }}: {{ sw.snmp_rw_community | to_json }}
{% endfor %}
{% else %}
poe_communities: {}
{% endif %}
{% if pi_pw is defined %}
pi_password_b64: {{ pi_pw | b64encode | to_json }}
{% endif %}

# {{ ansible_managed }}
# Core dnsmasq configuration for PXE boot

# Listen on the internal network interface
{% if eth_local is defined %}
interface={{ eth_local }}
{% endif %}
# bind-dynamic (not bind-interfaces): the per-port VLAN interfaces (v2101...)
# are created by the vlan-ports role and mostly have no carrier until a Pi is
# plugged into that switch port. bind-interfaces makes dnsmasq abort at start
# if any named interface is absent/down; bind-dynamic binds each interface as
# it appears and lets dnsmasq start regardless -- essential with ~150 per-port
# interfaces and to avoid a converge-time ordering race with networkd.
bind-dynamic

# Pin the lease database to an explicit, absolute, persistent path.
# dnsmasq daemonizes and chdir()s to "/" before opening a relative
# dhcp-leasefile/pid-file/log path, silently failing if one is given
# relative (tests/lab/RESULTS.md, "Other gotchas").
dhcp-leasefile=/var/lib/misc/dnsmasq.leases

{% if dhcp_range is defined %}
# DHCP range for legacy MAC-table hosts (no per-port switches config):
# per-port hosts get their v4/v6 ranges from ports.conf instead, one
# dhcp-range per switch port -- see tests/lab/RESULTS.md.
dhcp-range={{ dhcp_range }}
{% endif %}

# Enable TFTP (see tftp_root in group_vars/all/srv.yml)
enable-tftp
tftp-root={{ tftp_root }}

# Log DHCP transactions for debugging
log-dhcp

# Don't use /etc/resolv.conf - we are the DNS server
no-resolv
server=8.8.8.8

# Advertise the server as the NTP source: Pis have no internet (forward
# policy drop) and their clocks otherwise sit on the fake-hwclock date
# forever (tweed rebuild C2-2 — the old server ran chrony configured
# out-of-band; captured here so a fresh install serves time too).
dhcp-option=option:ntp-server,{{ eth_local_address }}

#!/usr/bin/python3 -I
"""dnsmasq's dhcp-script on the gateway: publish each per-port lease event to the site.

dnsmasq runs it (as nobody: dhcp-scriptuser in /etc/dnsmasq.d/lease-events.conf) as
``<action> <mac, or the client DUID for IPv6> <address> [<hostname>]`` with DNSMASQ_* variables in the environment
(dnsmasq(8), --dhcp-script). With --script-on-renewal it also runs on every renewal, as "old", so each DHCPACK on a
per-port interface becomes one record with acked_at set: the gateway's heartbeat of that board (see record() for
how a renewal is told from dnsmasq re-reading its leases at start).

The record goes to the site's MQTT broker on topic fpgas/<site>/gw/lease (site and broker address from
/etc/fpgas/lease-events.conf), with the field names the Pi's own network-state record uses. Events on the quarantine
pool and the other actions (init, tftp, arp-add, arp-del, relay-snoop, and any new one) publish nothing. A lease's
port comes from its address through ports.conf, never from DNSMASQ_INTERFACE (see port_table()).

dnsmasq waits for its script, so this is short: one mosquitto_pub with a timeout, no retry. A record that cannot be
published is written to stderr (dnsmasq's journal) and the event is otherwise lost; the next renewal sends another.

It replaces send_stat.py, which this configuration named for years but which was never installed on the gateway
(fpgas.online-infra #194): every lease event logged "failed to execute".
"""

import ipaddress
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone

EVENTS_CONF = "/etc/fpgas/lease-events.conf"
PORTS_CONF = "/etc/dnsmasq.d/ports.conf"
# a lease whose time left is within this of the full lease time was just granted or renewed
ACK_SLACK = 15
MOSQUITTO_PUB = "/usr/bin/mosquitto_pub"
CHILD_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C"}
TIMEOUT = 3
ACTIONS = ("add", "old", "del")
_RANGE = re.compile(r"dhcp-range=tag:(v([0-9]{4})),([^,]+),([^,]+),.*,([0-9]+)([smhd]?)")
_MAC = re.compile(r"[0-9a-f]{2}(:[0-9a-f]{2}){5}")
_DIGITS = re.compile(r"[0-9]+")
_UNITS = {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}


def iso(seconds):
    return datetime.fromtimestamp(seconds, timezone.utc).isoformat(timespec="seconds")


def port_table(text):
    """{address: (interface, lease seconds)} for every per-port address in ports.conf: each port interface v<vlan>
    has one IPv4 and one IPv6 range of a single address. This, not DNSMASQ_INTERFACE, says which port a lease is on:
    every port interface of a switch carries the same <base><switch>::ffff/64, so for an IPv6 lease dnsmasq names
    the first interface with that prefix (seen 14 Oct 2026: DHCPREPLY on v2230, the script told v2202)."""
    table = {}
    for line in text.splitlines():
        m = _RANGE.fullmatch(line.strip())
        if not m or m[3] != m[4]:
            continue
        try:
            address = ipaddress.ip_address(m[3])
        except ValueError:
            continue
        table[address] = (m[1], int(m[5]) * _UNITS[m[6]])
    return table


def record(args, env, now, ports):
    """The lease record for one dnsmasq call, or None for anything that is not a per-port lease event.

    `ports` is port_table() of ports.conf: the lease's address gives its port and the port's lease time. An address
    that is no port's own (the quarantine pool on the trunk) is not a board's lease.

    dnsmasq runs the script with "old" both for a renewal (script-on-renewal) and for each lease it re-reads when it
    starts, and neither is marked: DNSMASQ_DATA_MISSING is set for both on IPv4 (dnsmasq 2.91 rfc2131.c collects a
    client's extra data only on SELECTING and INIT-REBOOT). A renewal leaves the full lease time, a re-read of an
    older lease less, so "old" is an ack when the time left is within ACK_SLACK of the lease time either way (a lease
    granted under an earlier, longer lease time has more left and is no ack)."""
    if len(args) < 3 or args[0] not in ACTIONS:
        return None
    action, who, address = args[0], args[1], args[2]
    try:
        ip = ipaddress.ip_address(address)
    except ValueError:
        return None
    if ip not in ports:
        return None  # the quarantine pool, or any address that is not a port's own
    family = ip.version
    iface, lease_time = ports[ip]
    switch, port = divmod(int(iface[1:]) - 2000, 100)
    if switch < 1 or port < 1:
        return None
    mac = who if family == 4 else env.get("DNSMASQ_MAC")
    if mac is not None and not _MAC.fullmatch(mac):
        mac = None
    expires = env.get("DNSMASQ_LEASE_EXPIRES", "")
    remaining = env.get("DNSMASQ_TIME_REMAINING", "")
    remaining = int(remaining) if _DIGITS.fullmatch(remaining) else None
    acked = action == "add" or (action == "old" and remaining is not None and lease_time is not None
                                and lease_time - ACK_SLACK <= remaining <= lease_time + ACK_SLACK)
    return {
        "schema": 1, "switch": switch, "port": port, "hostname": f"pi-sw{switch}-p{port}", "at": iso(now),
        "event": action, "family": family, "address": address, "mac": mac, "server": None,
        "lifetime_s": remaining if acked else None,
        "acked_at": iso(now) if acked else None,
        "expires": int(expires) if _DIGITS.fullmatch(expires) else None,
        "interface": iface,
    }


def read_config(path):
    """(site, broker address) from `site=<name>` and `broker=<address>` lines of the lease-events config."""
    found = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            key, _, value = line.strip().partition("=")
            if key in ("site", "broker"):
                found[key] = value
    site, broker = found.get("site", ""), found.get("broker", "")
    if not re.fullmatch(r"[a-z0-9-]+", site):
        raise ValueError(f"{path} names no site")
    ipaddress.ip_address(broker)  # ValueError when it is not an address
    return site, broker


def main(args, env, now):
    try:
        with open(PORTS_CONF, encoding="utf-8") as f:
            ports = port_table(f.read())
    except OSError as exc:
        # no ports.conf, no way to tell which port a lease is on: nothing is published
        print(f"fpgas-lease-event: {PORTS_CONF}: {exc}", file=sys.stderr)
        return 0
    doc = record(args, env, now, ports)
    if doc is None:
        return 0
    try:
        site, broker = read_config(EVENTS_CONF)
        done = subprocess.run([MOSQUITTO_PUB, "-h", broker, "-q", "1", "-t", f"fpgas/{site}/gw/lease",
                               "-m", json.dumps(doc)], env=CHILD_ENV, capture_output=True, text=True,
                              timeout=TIMEOUT, check=False)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        print(f"fpgas-lease-event: {doc['event']} {doc['address']} not published: {exc}", file=sys.stderr)
        return 0
    if done.returncode != 0:
        print(f"fpgas-lease-event: {doc['event']} {doc['address']} not published: mosquitto_pub exited "
              f"{done.returncode}: {done.stderr.strip()[:200]}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], dict(os.environ), datetime.now(timezone.utc).timestamp()))

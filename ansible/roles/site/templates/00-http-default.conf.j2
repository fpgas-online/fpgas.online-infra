# {{ ansible_managed }}
# Default server - catch-all for port 80
# Serves ACME challenges from webroot, redirects everything else to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

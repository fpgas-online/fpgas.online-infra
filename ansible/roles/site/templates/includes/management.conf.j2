# {{ ansible_managed }} -- management dashboards (fpgas.online-site#66): public,
# read-only pages (/management/, /management/switches/; /management/fpgas/
# redirects to the Pi dashboard at /fleet/, fleet.conf.j2)
# plus /management/switches.json
  location /management/ {
    include proxy_params;
    proxy_pass http://unix:/run/gunicorn.sock;
  }

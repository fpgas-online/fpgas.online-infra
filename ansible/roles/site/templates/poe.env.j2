# {{ ansible_managed }}
# PoE control and the switch poller (fpgas.online-poe's snmp_switch) on a per-port-VLAN host: the switch topology
# comes from the file switch-vlans renders, the community for each switch from the vault. Read by systemd for
# gunicorn and switch-poller (EnvironmentFile=); root-only, the one place on disk the communities are.
# Values in double quotes with \ and " escaped: systemd's EnvironmentFile parsing would otherwise strip or mangle them.
FPGAS_SWITCHES_CONFIG=/etc/fpgas/switches.yml
{% for sw in switches if sw.snmp_rw_community is defined %}
FPGAS_SWITCH_COMMUNITY_{{ sw.index }}="{{ sw.snmp_rw_community | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}

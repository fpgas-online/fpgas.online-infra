# Lab client: a visitor's (or an administrator's) machine with stock OpenSSH.
FROM debian:trixie
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openssh-client rsync python3 netcat-openbsd procps \
 && rm -rf /var/lib/apt/lists/*
COPY askpass /usr/local/bin/askpass
COPY ptyrun.py /usr/local/bin/ptyrun.py
RUN chmod 755 /usr/local/bin/askpass /usr/local/bin/ptyrun.py
